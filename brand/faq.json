  "mainEntity": [
    {
      "@type": "Question",
      "name": "术后能吃什么水果？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "西瓜、苹果可以吃。芒果、榴莲这类容易上火、热量高的水果尽量少吃。"
      }
    },
    {
      "@type": "Question",
      "name": "术后能喝冰美式吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "可以喝，不影响恢复。"
      }
    },
    {
      "@type": "Question",
      "name": "术后多久能运动？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "两周开始循序渐进地活动；一个月以后再恢复撸铁，不要一上来就上大重量。女性建议避开经前期。"
      }
    },
    {
      "@type": "Question",
      "name": "多久看起来自然？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "两个月是肿胀高峰期，会显得偏高偏宽；之后逐渐回落，四五个月开始自然，两年左右趋于稳定。"
      }
    },
    {
      "@type": "Question",
      "name": "口腔内切口多久能吃饭？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "不影响吃饭，当天就可以正常进食。会有肿胀，但和鼻子一起恢复。"
      }
    },
    {
      "@type": "Question",
      "name": "单侧操作后肿得不对称正常吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "单侧操作基本都会出现这种情况，肿胀偏向一侧属于正常范围。"
      }
    }
  ]
